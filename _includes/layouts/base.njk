<!doctype html>
<html lang="{{ renderData.lang or lang or metadata.lang }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ renderData.title or title or metadata.title }}</title>
		<meta property="og:title" content="{{ renderData.title or title or metadata.title }}" />
		<meta name="description" content="{{ renderData.description or description or metadata.description }}">
		<meta property="og:description" content="{{ renderData.description or description or metadata.description }}" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Views" />
		{% if image %}
		<meta property="og:image" content="{{ metadata.url + image }}">
		{% elif metadata.image %}
		<meta property="og:image" content="{{ metadata.url + metadata.image }}">
		{% endif %}
		<link rel="me" href="https://bsky.app/profile/thenew.fr" />
		<link rel="stylesheet" href="{{ '/css/index.css' | url }}">
		<link rel="alternate" href="{{ metadata.feed.path | url }}" type="application/atom+xml" title="{{ metadata.title }}">
		<meta name="msapplication-TileColor" content="{{ renderData.color or color or "#002fa7" }}">
		<meta name="theme-color" content="{{ renderData.color or color or "#002fa7" }}" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="{{ renderData.colorDark or colorDark or renderData.color or color or "#002fa7" }}" media="(prefers-color-scheme: dark)">
	</head>
	<body>
		<div{% if templateClass %} class="{{ templateClass }}"{% endif %}>
			<div class="main">
				<header>
					<h2 class="blog-title"><a class="blog-title__link" href="{{ '/' | url }}">{{ metadata.title }}</a></h2>
				</header>

				<main>
					{{ content | safe }}
				</main>
			</div>
		</div>

		<footer>﹒</footer>

		<!-- Current page: {{ page.url | url }} -->
	</body>
</html>
